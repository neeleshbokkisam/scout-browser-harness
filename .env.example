# Personal Exa work-trial credentials only — copy to .env (gitignored).
# Do not put Merged Systems / Cursor org keys here.

# Exa Charon (OpenAI-compatible)
OPENAI_BASE_URL=https://charon.internal.exa.ai/v1
OPENAI_API_KEY=

# Scout / judge model (OpenAI-compatible id as used by Scout)
SCOUT_MODEL=openai/gpt-6-luna
JUDGE_MODEL=openai/gpt-6-luna

# Odysseys2 judge: attach screenshot PNGs (0/1; default off until proven)
# JUDGE_MULTIMODAL=0
# JUDGE_MAX_IMAGES=8

# Exa search
EXA_API_KEY=

# Optional: browser backends (fill only what you use)
# PLAYWRIGHT_BROWSER=chromium
# BROWSER_USE_API_KEY=
